# --- LLM provider: ollama | openai | demo ---------------------------------
# "ollama" : Ollama, either Ollama Cloud (below, default) or a local server
# "openai" : any OpenAI-compatible hosted API (OpenAI, Groq, OpenRouter, ...)
# "demo"   : deterministic rule-based policy. NOT an LLM. Clearly labelled in UI.
# The app never falls back from a real provider to demo on its own.
LLM_PROVIDER=ollama

# Ollama Cloud (fast, no local GPU). Create a key: https://ollama.com/settings/keys
# Use the API model name (gemma4:31b), NOT the CLI name (gemma4:cloud).
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b

# Local Ollama instead (leave OLLAMA_API_KEY empty):
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=mistral
# OLLAMA_NUM_CTX=8192   # local only; ignored for Ollama Cloud

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=300
LLM_MAX_REPAIRS=2

# --- Chat agent -----------------------------------------------------------
# native : the model calls tools itself (LangChain bind_tools). Needs a model with tool support.
# json   : the model is asked for one JSON action per turn instead. Use this if chat reports
#          "does not support tool calling" for your model.
TOOL_CALLING=native
CHAT_MAX_TOOL_ROUNDS=6
CHAT_HISTORY_MESSAGES=20

# --- Document library ------------------------------------------------------
# MAX_DOCUMENT_BYTES=5000000
# DOCUMENTS_DIR=./data/documents
# CHECKPOINT_PATH=            # LangGraph checkpoint DB; empty = next to the main database

# --- Agent limits --------------------------------------------------------
MAX_STEPS=12
MAX_TOOL_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
TASK_TIMEOUT_SECONDS=1800
REQUIRE_WRITE_APPROVAL=true

# --- Demo-only fault injection (leave empty normally) ---------------------
# write_timeout_once : first invoice write commits, then raises a simulated timeout
# read_flaky_once    : first invoice lookup raises a simulated transient error
FAULT_INJECTION=

# --- Paths (defaults are fine) -------------------------------------------
# DATABASE_URL=sqlite:///./data/taskpilot.db
# WORKSPACE_ROOT=../sample_data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
